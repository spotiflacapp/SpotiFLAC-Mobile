root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{kt,kts,swift}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
